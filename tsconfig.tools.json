{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "packages/*/scripts/**/*.ts"
  ]
}
